          "stringUnit": {
            "state": "translated",
            "value": "ABOUT ROTASH"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ROTASH について"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ROTASH 소개"
          }
        }
      }
    },
    "ROTASH の名前": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ROTASH NAME"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ROTASH の名前"
          }
        },
        "ko": {
          "stringUnit": {
