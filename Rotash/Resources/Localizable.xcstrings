    "サーバーとの通信に失敗しました（%lld）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't connect to the server (%lld)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーとの通信に失敗しました（%lld）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버와 통신하지 못했어요 (%lld)."
          }
        }
      }
    },
    "サーバー上のデータを読めませんでした。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the data on the server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー上のデータを読めませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버의 데이터를 읽을 수 없어요."
          }
        }
      }
    },
    "タップすると、その週を見られます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to see that week."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップすると、その週を見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하면 그 주를 볼 수 있어요."
          }
        }
      }
    },
    "バトンファイルを読み込めませんでした。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the baton file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バトンファイルを読み込めませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바톤 파일을 읽을 수 없어요."
          }
        }
      }
    },
    "バトン（同期を使わずに、ファイルで手渡しします）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BATON (hand over a file instead of syncing)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バトン（同期を使わずに、ファイルで手渡しします）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바톤 (동기화 없이 파일로 직접 전달해요)"
          }
        }
      }
    },
    "メンバー（この順に当番がまわります）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MEMBERS (turns go in this order)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバー（この順に当番がまわります）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멤버 (이 순서대로 차례가 돌아가요)"
          }
        }
      }
    },
    "今すぐ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 동기화"
          }
        }
      }
    },
    "今日の担当": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TODAY'S TURN"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の担当"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 차례"
          }
        }
      }
    },
    "今日は %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's %@'s turn today"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 %@ 차례예요"
          }
        }
      }
    },
    "今日は撮れません": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't shoot today"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は撮れません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 찍을 수 없어요"
          }
        }
      }
    },
    "今週の Rotash": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week's Rotash"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週の Rotash"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주 Rotash"
          }
        }
      }
    },
    "今週の作品ができました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week's piece is complete"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週の作品ができました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주 작품이 완성됐어요"
          }
        }
      }
    },
    "先に Rotash を作るか、招待コードで参加してください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a Rotash first, or join one with an invite code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に Rotash を作るか、招待コードで参加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 Rotash를 만들거나 초대 코드로 참여해 주세요."
          }
        }
      }
    },
    "写真 %lld 枚を送れませんでした。%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't send %lld photo(s). %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真 %lld 枚を送れませんでした。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 %lld장을 보내지 못했어요. %@"
          }
        }
      }
    },
    "写真のアップロードに失敗しました。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo upload failed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真のアップロードに失敗しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 업로드하지 못했어요."
          }
        }
      }
    },
    "加工はしません。画面のまま1枚にして書き出します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No filters or edits. It's exported as one image, just as you see it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "加工はしません。画面のまま1枚にして書き出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보정은 하지 않아요. 화면 그대로 한 장으로 내보내요."
          }
        }
      }
    },
    "参加したら、誰かに「バトンを渡す」でその週の作品を送ってもらってください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After joining, ask someone to send you the week's piece with “Pass the baton.”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加したら、誰かに「バトンを渡す」でその週の作品を送ってもらってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참여한 뒤에 누군가에게 ‘바톤 넘기기’로 그 주의 작품을 보내 달라고 하세요."
          }
        }
      }
    },
    "参加する": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참여하기"
          }
        }
      }
    },
    "参加すると、今週の作品とメンバーがそのまま見られます。\nまだ来ていない日が残っていれば、その当番にも入ります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you join, you'll see this week's piece and members right away.\nIf any days are still ahead, you'll get a turn too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加すると、今週の作品とメンバーがそのまま見られます。\nまだ来ていない日が残っていれば、その当番にも入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참여하면 이번 주 작품과 멤버를 바로 볼 수 있어요.\n아직 오지 않은 날이 남아 있으면 그날 차례도 맡게 돼요."
          }
        }
      }
    },
    "友達と1週間かけて、\n7枚で1つの作品をつくる。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend a week with friends\nmaking one piece from 7 photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友達と1週間かけて、\n7枚で1つの作品をつくる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구들과 일주일 동안\n7장으로 하나의 작품을 만들어요."
          }
        }
      }
    },
