        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 코드"
          }
        }
      }
    },
    "招待コードが違います（このRotashは %@ / ファイルは %@）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The invite code doesn't match (this Rotash: %@ / file: %@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待コードが違います（このRotashは %@ / ファイルは %@）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 코드가 달라요 (이 Rotash: %@ / 파일: %@)."
          }
        }
      }
    },
    "招待コードで参加": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join with invite code"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待コードで参加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 코드로 참여"
          }
        }
      }
    },
    "招待コードを入れた人が、そのままメンバーに加わります。まだ来ていない日があれば、今週の当番にも入ります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone who enters the invite code joins as a member right away. If any days are still ahead, they'll get a turn this week too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待コードを入れた人が、そのままメンバーに加わります。まだ来ていない日があれば、今週の当番にも入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 코드를 입력한 사람은 바로 멤버가 돼요. 아직 오지 않은 날이 있으면 이번 주 차례에도 들어가요."
          }
        }
      }
    },
    "撮るのは1日にひとりだけ。\n見るのはいつでも全員。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one person shoots each day.\nEveryone can look anytime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮るのは1日にひとりだけ。\n見るのはいつでも全員。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찍는 건 하루에 한 사람만.\n보는 건 언제나 모두가."
          }
        }
      }
    },
    "撮るのは1日にひとりだけ。見るのはいつでも全員。\n日曜日が終わると、その週の作品が完成します。\n完成した作品は Memories に残ります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one person shoots each day. Everyone can look anytime.\nWhen Sunday ends, the week's piece is complete.\nFinished pieces are kept in Memories."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮るのは1日にひとりだけ。見るのはいつでも全員。\n日曜日が終わると、その週の作品が完成します。\n完成した作品は Memories に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찍는 건 하루에 한 사람만. 보는 건 언제나 모두가.\n일요일이 끝나면 그 주의 작품이 완성돼요.\n완성된 작품은 Memories에 남아요."
          }
        }
      }
    },
    "新しいグループをつくる": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new group"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいグループをつくる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 그룹 만들기"
          }
        }
      }
    },
    "本当に抜ける（この端末からこのグループの写真が消えます）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Really leave? (This group's photos will be removed from this device)"
