        }
      }
    },
    "開いたとき・横にしたとき・撮ったときに、自動でみんなの写真を取りに行きます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone's photos are fetched automatically when you open the app, turn it sideways, or take a photo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いたとき・横にしたとき・撮ったときに、自動でみんなの写真を取りに行きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열 때, 가로로 돌릴 때, 사진을 찍을 때 자동으로 모두의 사진을 가져와요."
          }
        }
      }
    },
