            "value": "Rotash 만들기"
          }
        }
      }
    },
    "→ 横にして見る": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "→ Turn sideways to view"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "→ 横にして見る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "→ 가로로 돌려서 보기"
          }
        }
      }
    },
    "↺ 表に戻す": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "↺ Show front"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "↺ 表に戻す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "↺ 앞면 보기"
          }
        }
      }
    },
    "↻ 裏返す": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "↻ Show back"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "↻ 裏返す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "↻ 뒷면 보기"
          }
        }
      }
    },
    "あなたの名前": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YOUR NAME"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの名前"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 이름"
          }
        }
      }
    },
    "この1週間、一緒に1枚にしない？\n招待コード %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want to make one picture together this week?\nInvite code %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この1週間、一緒に1枚にしない？\n招待コード %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 한 주, 같이 한 장 만들어 볼래요?\n초대 코드 %@"
          }
        }
      }
    },
    "この1週間に名前をつける": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name this week"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この1週間に名前をつける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주에 이름 붙이기"
          }
        }
      }
    },
    "このグループから抜ける": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave this group"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループから抜ける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹에서 나가기"
          }
        }
      }
    },
    "このグループにはもう参加しています。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're already in this group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループにはもう参加しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 이 그룹에 참여하고 있어요."
          }
        }
      }
    },
    "このコードを友達に渡してください。\nコードを入れた人がそのままメンバーになります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give this code to your friends.\nAnyone who enters it becomes a member right away."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードを友達に渡してください。\nコードを入れた人がそのままメンバーになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드를 친구에게 알려 주세요.\n코드를 입력한 사람은 바로 멤버가 돼요."
          }
        }
      }
    },
    "この日は写真がありません": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No photo for this day"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日は写真がありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이날은 사진이 없어요"
          }
        }
      }
    },
    "たとえば 8月の1週間": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. A week in August"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たとえば 8月の1週間"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 8월의 한 주"
          }
        }
      }
    },
    "つくる": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つくる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만들기"
          }
        }
      }
    },
    "つくると招待コードが出ます。\nそのコードを渡した人が参加すると、自動でメンバーに加わります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once it's created, you'll get an invite code.\nAnyone you give the code to is added as a member automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つくると招待コードが出ます。\nそのコードを渡した人が参加すると、自動でメンバーに加わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만들면 초대 코드가 나와요.\n코드를 받은 사람이 참여하면 자동으로 멤버가 돼요."
          }
        }
      }
    },
    "つける": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장"
          }
        }
      }
    },
    "とじる": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "とじる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        }
      }
    },
    "はじめる": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
